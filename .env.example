# Copy to .env at repository root; dotenv is loaded by the API and Prisma.
DATABASE_URL="postgresql://duoquest:duoquest_dev@127.0.0.1:5432/duoquest?schema=public"
POSTGRES_USER=duoquest
POSTGRES_PASSWORD=duoquest_dev
POSTGRES_DB=duoquest
# For Cloudflare Tunnel-only exposure, prefer API_HOST=127.0.0.1 so the API is not reachable directly on LAN.
API_HOST=0.0.0.0
API_PORT=4000
# Exact comma-separated browser origins. Add your LAN or HTTPS tunnel origin (e.g. https://game.example.com).
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated HTTPS origins for Quiz images, e.g. https://cdn.example.com
QUIZ_IMAGE_CDN_ORIGINS=
# Optional web override: copy into apps/web/.env.local when API uses another port or same-origin HTTPS tunnel.
# NEXT_PUBLIC_API_URL=https://game.example.com
# Enable account registration/login UI over HTTPS (must match ALLOW_PUBLIC_ACCOUNT_AUTH on API).
# NEXT_PUBLIC_ALLOW_PUBLIC_ACCOUNT_AUTH=true

# Reverse proxy IP trust: set to "cloudflare" ONLY when traffic reaches API via local cloudflared on loopback.
TRUST_PROXY_MODE=none
# Swagger UI (/api/docs) defaults to true in development and false when NODE_ENV=production.
# ENABLE_SWAGGER=false

# Auth account origin. Keep WEB_ORIGINS aligned with this origin.
# Set ALLOW_PUBLIC_ACCOUNT_AUTH=true and HTTPS AUTH_WEB_ORIGIN to allow Gmail OTP registration/login via Cloudflare Tunnel.
AUTH_WEB_ORIGIN=http://localhost:3000
ALLOW_PUBLIC_ACCOUNT_AUTH=false
# Generate a stable secret for real mail flows:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# AUTH_SECRET=
# HTTPS uses Secure cookies. Set true (or NODE_ENV=production) when exposing over Cloudflare Tunnel.
AUTH_COOKIE_SECURE=false
# Configure these on the API host to send real verification mail over TLS (e.g. Gmail App Password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
