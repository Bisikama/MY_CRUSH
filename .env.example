# Copy to .env at repository root; dotenv is loaded by the API and Prisma.
DATABASE_URL="postgresql://duoquest:duoquest_dev@127.0.0.1:5432/duoquest?schema=public"
POSTGRES_USER=duoquest
POSTGRES_PASSWORD=duoquest_dev
POSTGRES_DB=duoquest
API_HOST=0.0.0.0
API_PORT=4000
# Exact comma-separated browser origins. Add your LAN web origin before LAN play.
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated HTTPS origins for Quiz images, e.g. https://cdn.example.com
QUIZ_IMAGE_CDN_ORIGINS=
# Optional web override: copy into apps/web/.env.local when API uses another port.
# NEXT_PUBLIC_API_URL=http://YOUR_LAN_IP:4000

# Auth account flows on localhost. Keep WEB_ORIGINS aligned with this origin.
AUTH_WEB_ORIGIN=http://localhost:3000
# Generate a stable secret for real mail flows:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# AUTH_SECRET=
# HTTPS uses Secure cookies. Keep false for localhost HTTP and guest LAN dev.
AUTH_COOKIE_SECURE=false
# Configure these on the API host to send real verification mail over TLS.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
