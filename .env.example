# Copy to .env at repository root; dotenv is loaded by the API and Prisma.
DATABASE_URL="postgresql://duoquest:duoquest_dev@127.0.0.1:5432/duoquest?schema=public"
POSTGRES_USER=duoquest
POSTGRES_PASSWORD=duoquest_dev
POSTGRES_DB=duoquest
API_HOST=0.0.0.0
API_PORT=4000
# Exact comma-separated browser origins. Add your LAN web origin before LAN play.
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional web override: copy into apps/web/.env.local when API uses another port.
# NEXT_PUBLIC_API_URL=http://YOUR_LAN_IP:4000
