{
  "$ref": "#/definitions/QuestionPack",
  "definitions": {
    "QuestionPack": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "packId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "knowledgeType": {
          "type": "string",
          "enum": [
            "academic",
            "practical",
            "discovery"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "relatedKnowledge": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "topic": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "category",
              "topic",
              "reason"
            ],
            "additionalProperties": false
          },
          "maxItems": 12
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "type": {
                "type": "string",
                "const": "single_choice"
              },
              "topic": {
                "$ref": "#/definitions/QuestionPack/properties/relatedKnowledge/items/properties/reason"
              },
              "difficulty": {
                "type": "string",
                "enum": [
                  "easy",
                  "medium",
                  "hard"
                ]
              },
              "prompt": {
                "$ref": "#/definitions/QuestionPack/properties/relatedKnowledge/items/properties/reason"
              },
              "images": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "src": {
                      "type": "string",
                      "maxLength": 1024,
                      "pattern": "^(?:\\/images\\/quiz\\/|https:\\/\\/[a-zA-Z0-9.-]+(?::[0-9]+)?\\/)(?:[a-zA-Z0-9_-][a-zA-Z0-9_.~-]*\\/)*[a-zA-Z0-9_-][a-zA-Z0-9_.~-]*\\.(?:webp|jpe?g|png|avif)(?![\\s\\S])"
                    },
                    "alt": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "required": [
                    "src",
                    "alt"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 4
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "enum": [
                        "A",
                        "B",
                        "C",
                        "D"
                      ]
                    },
                    "text": {
                      "$ref": "#/definitions/QuestionPack/properties/relatedKnowledge/items/properties/reason"
                    }
                  },
                  "required": [
                    "id",
                    "text"
                  ],
                  "additionalProperties": false
                },
                "minItems": 4,
                "maxItems": 4
              },
              "correctOptionId": {
                "$ref": "#/definitions/QuestionPack/properties/questions/items/properties/options/items/properties/id"
              },
              "explanation": {
                "$ref": "#/definitions/QuestionPack/properties/relatedKnowledge/items/properties/reason"
              },
              "hints": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/QuestionPack/properties/relatedKnowledge/items/properties/reason"
                },
                "maxItems": 5,
                "default": []
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 80
                },
                "maxItems": 20,
                "default": []
              },
              "timeLimitSeconds": {
                "type": "integer",
                "minimum": 5,
                "maximum": 120,
                "default": 20
              }
            },
            "required": [
              "id",
              "type",
              "topic",
              "difficulty",
              "prompt",
              "options",
              "correctOptionId",
              "explanation"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 500
        }
      },
      "required": [
        "schemaVersion",
        "packId",
        "title",
        "language",
        "category",
        "questions"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
