{
  "$ref": "#/definitions/QuestionPack",
  "definitions": {
    "QuestionPack": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "packId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "type": {
                "type": "string",
                "const": "single_choice"
              },
              "topic": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "difficulty": {
                "type": "string",
                "enum": ["easy", "medium", "hard"]
              },
              "prompt": {
                "$ref": "#/definitions/QuestionPack/properties/questions/items/properties/topic"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "enum": ["A", "B", "C", "D"]
                    },
                    "text": {
                      "$ref": "#/definitions/QuestionPack/properties/questions/items/properties/topic"
                    }
                  },
                  "required": ["id", "text"],
                  "additionalProperties": false
                },
                "minItems": 4,
                "maxItems": 4
              },
              "correctOptionId": {
                "$ref": "#/definitions/QuestionPack/properties/questions/items/properties/options/items/properties/id"
              },
              "explanation": {
                "$ref": "#/definitions/QuestionPack/properties/questions/items/properties/topic"
              },
              "hints": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/QuestionPack/properties/questions/items/properties/topic"
                },
                "maxItems": 5,
                "default": []
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 80
                },
                "maxItems": 20,
                "default": []
              },
              "timeLimitSeconds": {
                "type": "integer",
                "minimum": 5,
                "maximum": 120,
                "default": 20
              }
            },
            "required": [
              "id",
              "type",
              "topic",
              "difficulty",
              "prompt",
              "options",
              "correctOptionId",
              "explanation"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 500
        }
      },
      "required": ["schemaVersion", "packId", "title", "language", "category", "questions"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
